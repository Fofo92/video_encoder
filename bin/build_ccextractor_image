#!/usr/bin/env bash

set -euo pipefail

readonly PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly VERSION="${1:-0.96.5}"

case "$VERSION" in
0.96.5)
  readonly CCEXTRACTOR_COMMIT="477307e438a6089314f3c1d7fe083943220e90fa"
  ;;
0.96.6)
  readonly CCEXTRACTOR_COMMIT="185631dcb0217b4ad09d43009cb69f0593996a5d"
  ;;
*)
  printf \
    'Usage: bin/build_ccextractor_image [0.96.5|0.96.6]\n' \
    >&2
  exit 2
  ;;
esac

readonly SOURCE_URL="https://github.com/CCExtractor/ccextractor.git"
readonly SOURCE_TAG="v${VERSION}"
readonly IMAGE_SUFFIX="${VIDEO_ENCODER_CCEXTRACTOR_BUILD_SUFFIX:-}"
readonly BASE_IMAGE="video-encoder-ccextractor-build:${VERSION}-ocr${IMAGE_SUFFIX}"
readonly OUTPUT_IMAGE="video-encoder-ccextractor:${VERSION}-ocr-fra${IMAGE_SUFFIX}"
readonly DOCKERFILE="${PROJECT_ROOT}/docker/ccextractor/Dockerfile"

build_directory="$(mktemp -d \
  "/tmp/video_encoder_ccextractor_${VERSION}.XXXXXX")"
readonly build_directory

cleanup() {
  rm -rf -- "$build_directory"
}

trap cleanup EXIT

printf 'Cloning CCExtractor %s…\n' "$SOURCE_TAG"

git clone \
  --branch "$SOURCE_TAG" \
  --depth 1 \
  "$SOURCE_URL" \
  "$build_directory/ccextractor"

actual_commit="$(git \
  -C "$build_directory/ccextractor" \
  rev-parse HEAD)"

if [ "$actual_commit" != "$CCEXTRACTOR_COMMIT" ]; then
  printf \
    'Unexpected commit for %s: expected %s, got %s\n' \
    "$SOURCE_TAG" \
    "$CCEXTRACTOR_COMMIT" \
    "$actual_commit" \
    >&2
  exit 1
fi

patch_path="${PROJECT_ROOT}/docker/ccextractor/patches/${SOURCE_TAG}-version.patch"

if [ -f "$patch_path" ]; then
  printf 'Applying packaging patch %s…\n' \
    "$(basename "$patch_path")"

  git \
    -C "$build_directory/ccextractor" \
    apply \
    --check \
    "$patch_path"

  git \
    -C "$build_directory/ccextractor" \
    apply \
    "$patch_path"
fi

if [ "$VERSION" = "0.96.6" ]; then
  dvb_patch_path="${PROJECT_ROOT}/docker/ccextractor/patches/v0.96.6-dvb-null-guard.patch"

  if [ ! -f "$dvb_patch_path" ]; then
    printf 'Missing DVB patch: %s\n' "$dvb_patch_path" >&2
    exit 1
  fi

  printf 'Checking DVB subtitle safety patch…\n'

  git \
    -C "$build_directory/ccextractor" \
    apply \
    --check \
    --unidiff-zero \
    "$dvb_patch_path"

  git \
    -C "$build_directory/ccextractor" \
    apply \
    --unidiff-zero \
    "$dvb_patch_path"
fi

printf 'Building upstream OCR image…\n'

docker build \
  --build-arg USE_LOCAL_SOURCE=1 \
  --build-arg BUILD_TYPE=ocr \
  --file "$build_directory/ccextractor/docker/Dockerfile" \
  --tag "$BASE_IMAGE" \
  "$build_directory/ccextractor"

printf 'Adding French OCR data…\n'

docker build \
  --build-arg "CCEXTRACTOR_BASE_IMAGE=${BASE_IMAGE}" \
  --build-arg "CCEXTRACTOR_VERSION=${VERSION}" \
  --build-arg "CCEXTRACTOR_COMMIT=${CCEXTRACTOR_COMMIT}" \
  --file "$DOCKERFILE" \
  --tag "$OUTPUT_IMAGE" \
  "${PROJECT_ROOT}/docker/ccextractor"

image_id="$(docker image inspect \
  "$OUTPUT_IMAGE" \
  --format '{{.Id}}')"

printf 'Built %s\n' "$OUTPUT_IMAGE"
printf 'Image ID: %s\n' "$image_id"
