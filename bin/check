#!/usr/bin/env bash

set -euo pipefail

readonly PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

run_step() {
  local label="$1"
  shift

  printf '\n🐷  %s\n' "$label"

  if "$@"; then
    printf '✅  %s\n' "$label"
  else
    printf '❌  %s\n' "$label" >&2
    exit 1
  fi
}

check_shell_syntax() {
  bash -n \
    bin/check \
    bin/build_ccextractor_image

  sh -n \
    bin/video_encoder_ccextractor \
    bin/video_encoder_ui
}

check_python_syntax() {
  python3 -m compileall \
    -q \
    ui/video_encoder_ui
}

check_git_whitespace() {
  git diff --check
  git diff --cached --check
}

run_python_unit_tests() {
  PYTHONPATH="$PROJECT_ROOT/ui" \
    python3 -m unittest discover \
      -s ui/tests \
      -p 'test_*.py'
}

run_integration_checks() {
  if ! command -v melt-7 >/dev/null 2>&1; then
    printf '\n⚠️  Tests d’intégration ignorés : melt-7 est introuvable.\n'
    return
  fi

  run_step \
    "Tests d’intégration MLT" \
    bundle exec rspec --tag integration
}

printf '🐷  Rubychon inspecte video_encoder…\n'

run_step \
  "Dépendances Ruby" \
  bundle check

run_step \
  "Syntaxe des scripts shell" \
  check_shell_syntax

run_step \
  "Syntaxe de l’IHM Python" \
  check_python_syntax

run_step \
  "Blancs indésirables dans les modifications Git" \
  check_git_whitespace

run_step \
  "Tests unitaires Python" \
  run_python_unit_tests

run_step \
  "Analyse RuboCop" \
  bundle exec rubocop

run_step \
  "Tests unitaires Ruby" \
  bundle exec rspec --tag '~integration'

case "${1:-}" in
  --integration | --all)
    run_integration_checks
    ;;
  "")
    ;;
  *)
    printf '\nUsage : bin/check [--integration|--all]\n' >&2
    exit 2
    ;;
esac

printf '\n🐷✨ Tout est propre. Rubychon approuve !\n'
